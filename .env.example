# PostgreSQL for the research schema. Article analysis currently does not persist.
DATABASE_URL="postgresql://user:password@localhost:5432/biaslens"

# Configure at least one AI provider for POST /api/analyze (ai-kit fallback).
# Never put real credentials into a Git commit or browser-side env variable.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional vendor-specific model overrides are read by @bitbaum/ai-kit.
# Model IDs must come from the shared provider catalogue, not app code.
