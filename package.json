{
  "name": "biaslens",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run design:check && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:check": "node --test scripts/design-check.mjs",
    "browser:smoke": "bash scripts/browser-smoke.sh",
    "eval:reports": "vitest run --config vitest.eval.config.ts",
    "test:writing-browser": "node scripts/writingkit-browser-check.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.20",
    "@bitbaum/accountkit": "^0.31.0",
    "@bitbaum/ai-kit": "^1.29.0",
    "@bitbaum/chartkit": "^0.8.0",
    "@bitbaum/chatkit": "^0.35.0",
    "@bitbaum/design-tokens": "^1.7.1",
    "@bitbaum/mail-kit": "^0.4.0",
    "@bitbaum/sitekit": "0.7.0",
    "@bitbaum/writingkit": "^0.2.0",
    "@fleet/ai-forms": "npm:@bitbaum/ai-forms@0.1.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.20",
    "@bitbaum/bip-kit": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "@bitbaum/limitkit": "^0.2.1",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.65.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
