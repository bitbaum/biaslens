{
  "name": "biaslens",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.1",
    "next": "^16",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10",
    "eslint-config-next": "^16",
    "prettier": "3.9.6",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
