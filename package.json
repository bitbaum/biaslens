{
  "name": "biaslens",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run design:check && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "design:check": "node --test scripts/design-check.mjs",
    "browser:smoke": "bash scripts/browser-smoke.sh",
    "eval:reports": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.13",
    "@bitbaum/accountkit": "^0.8.0",
    "@bitbaum/ai-kit": "^1.21.4",
    "@bitbaum/chatkit": "^0.21.1",
    "@bitbaum/design-tokens": "^1.2.0",
    "@bitbaum/mail-kit": "^0.2.0",
    "@bitbaum/sitekit": "0.4.2",
    "@fleet/ai-forms": "npm:ai-forms@0.1.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.13",
    "bip-kit": "^0.6.1",
    "drizzle-orm": "^0.45.4",
    "limitkit": "^0.2.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "1.9.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vite": "^8.3.5"
  }
}
