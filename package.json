{
  "name": "biaslens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "prettier": "3.9.6",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
